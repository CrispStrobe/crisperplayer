+int decode_one_frame(const uint8_t* data, size_t len, const StreamInfo& si,
+                     float* pcm, size_t pcm_samples, DecodedFrameInfo& info) {
+    if (!pcm || len > 2 * 1024 * 1024 || frame_info(data, len, si, info) < 0 ||
+        pcm_samples < (size_t)info.samples * si.channels) return -1;
+    std::vector<int64_t> frame;
+    FrameHeader h;
+    size_t consumed = 0;
+    if (decode_frame(data, len, si, frame, h, consumed) < 0) return -1;
+    const int64_t limit = int64_t{1} << (si.bits_per_sample - 1);
+    for (size_t i = 0; i < frame.size(); ++i) {
+        if (frame[i] < -limit || frame[i] >= limit) return -1;
+        pcm[i] = static_cast<float>(frame[i] / static_cast<double>(limit));
+    }
+    info.encoded_bytes = consumed;
+    return info.samples;
+}
