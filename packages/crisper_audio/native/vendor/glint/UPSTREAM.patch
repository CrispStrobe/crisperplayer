+// Crisper streaming entry points. Frame-local scratch is bounded by the
+// validated STREAMINFO maximum; neither function retains compressed input.
+int frame_info(const uint8_t* data, size_t len, const StreamInfo& si,
+               DecodedFrameInfo& info) {
+    info = {};
+    FrameHeader h;
+    if (!si.valid || si.channels < 1 || si.channels > 2 ||
+        si.bits_per_sample < 4 || si.bits_per_sample > 24 ||
+        si.max_block_size < 16 || si.max_block_size > 65535 ||
+        !parse_frame_header(data, len, si, h) ||
+        h.sample_rate != si.sample_rate || h.channels != si.channels ||
+        h.bits_per_sample != si.bits_per_sample ||
+        h.block_size > si.max_block_size ||
+        h.first_sample >= si.total_samples ||
+        h.first_sample + (uint64_t)h.block_size > si.total_samples)
+        return -1;
+    info.first_sample = h.first_sample;
+    info.samples = h.block_size;
+    return 0;
+}
