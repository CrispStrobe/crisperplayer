+        result = floats([0, 0])
+        ORIGINAL.reference_quadratic(floats([.7 - 1.2 + .8, .8, .7 + 1.2 + .8]), result)
+        x = -1.2 / (2 * .7)
+        y = .7 * x * x + 1.2 * x + .8
+        self.assertAlmostEqual(result[0], x, delta=1e-6)
+        self.assertAlmostEqual(result[1], y, delta=1e-6)
